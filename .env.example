# Copy this file to .env and fill in your own values. Never commit .env.

# LLM (Groq)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Embeddings: "openai" (default, uses OPENAI_API_KEY) or "local" (sentence-transformers, ~2.3 GB download)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
OPENAI_API_KEY=
# For local: EMBEDDING_PROVIDER=local and EMBEDDING_MODEL=BAAI/bge-m3

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# RDFox rule engine (see docs/RDFOX_SETUP.md)
RDFOX_ENDPOINT=http://localhost:12110
RDFOX_ROLE=admin
RDFOX_PASSWORD=admin
RDFOX_DATASTORE=mortgage
